# Node >=22.13. Run from the repository root; see the supplied run instructions.
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
# Relative to repository root, or absolute. Keep the database outside public assets.
DATABASE_PATH=data/waylist.sqlite

# Email endpoints return 503 until SMTP is configured. No tokens are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Require STARTTLS on non-465 ports; disable only for a trusted local mail server.
SMTP_REQUIRE_TLS=true

# Leave unset for direct connections. Set only behind a trusted reverse proxy.
# TRUST_PROXY_HOPS=1
# Production: NODE_ENV=production, APP_URL=https://your-domain.example
# Production serves the frontend build from dist/ and uses Secure cookies.
